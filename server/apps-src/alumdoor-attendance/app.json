{
  "id": "alumdoor-attendance",
  "name": "AlumDoor — Chấm công QR",
  "version": "0.1.2",
  "metaContractVersion": 1,
  "requires": [
    { "id": "hrm", "version": "1.8.0" }
  ],
  "externalDocTypes": [
    { "name": "Branch", "kind": "master", "app": "hrm" },
    { "name": "Company", "kind": "master", "app": "accounts" },
    { "name": "Department", "kind": "tree", "app": "hrm" },
    { "name": "Employee", "kind": "master", "app": "hrm" },
    { "name": "Employee Checkin", "kind": "transaction", "app": "hrm" },
    { "name": "User", "kind": "system", "app": "core" }
  ],
  "custom_fields": [
    {
      "name": "Employee Checkin-alu_station",
      "dt": "Employee Checkin",
      "fieldname": "alu_station",
      "field": { "label": "Tram QR AlumDoor", "fieldtype": "Link", "options": "AlumDoor QR Station", "read_only": true },
      "insert_after": "external_id"
    },
    {
      "name": "Employee Checkin-alu_work_date",
      "dt": "Employee Checkin",
      "fieldname": "alu_work_date",
      "field": { "label": "Ngay cong AlumDoor", "fieldtype": "Date", "read_only": true },
      "insert_after": "alu_station"
    },
    {
      "name": "Employee Checkin-alu_segment_code",
      "dt": "Employee Checkin",
      "fieldname": "alu_segment_code",
      "field": { "label": "Ca AlumDoor", "fieldtype": "Select", "options": "SHIFT1\nSHIFT2\nSHIFT3", "read_only": true },
      "insert_after": "alu_work_date"
    },
    {
      "name": "Employee Checkin-alu_token_nonce_hash",
      "dt": "Employee Checkin",
      "fieldname": "alu_token_nonce_hash",
      "field": { "label": "Ma bam QR", "fieldtype": "Data", "read_only": true },
      "insert_after": "alu_segment_code"
    },
    {
      "name": "Employee Checkin-alu_capture_source",
      "dt": "Employee Checkin",
      "fieldname": "alu_capture_source",
      "field": { "label": "Nguon quet AlumDoor", "fieldtype": "Select", "options": "QR", "read_only": true },
      "insert_after": "alu_token_nonce_hash"
    },
    {
      "name": "Employee Checkin-alu_device_fingerprint_hash",
      "dt": "Employee Checkin",
      "fieldname": "alu_device_fingerprint_hash",
      "field": { "label": "Ma bam thiet bi", "fieldtype": "Data", "read_only": true },
      "insert_after": "alu_capture_source"
    }
  ],
  "nav": [
    {
      "key": "alumdoor-attendance:kiosk",
      "label": "Màn QR chấm công",
      "kind": "experience",
      "icon": "scan-line",
      "group": "Chấm công & ca",
      "required_roles": [
        "AlumDoor Attendance Manager",
        "HR Manager",
        "System Manager"
      ]
    },
    {
      "key": "AlumDoor Attendance Day",
      "label": "Công ngày",
      "kind": "doctype",
      "icon": "calendar",
      "group": "Chấm công & ca",
      "required_roles": [
        "AlumDoor Attendance Viewer",
        "AlumDoor Attendance Manager",
        "HR Manager",
        "System Manager"
      ]
    },
    {
      "key": "AlumDoor QR Station",
      "label": "Trạm QR",
      "kind": "doctype",
      "icon": "scan-line",
      "group": "Chấm công & ca",
      "required_roles": [
        "AlumDoor Attendance Manager",
        "HR Manager",
        "System Manager"
      ]
    },
    {
      "key": "AlumDoor Attendance Policy",
      "label": "Chính sách ca",
      "kind": "doctype",
      "icon": "timer",
      "group": "Chấm công & ca",
      "required_roles": [
        "AlumDoor Attendance Manager",
        "HR Manager",
        "System Manager"
      ]
    }
  ],
  "hooks": []
}
