{
  "name": "kho",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "dev:attendance": "vite --config vite.attendance.config.ts",
    "typecheck": "tsc -b && tsc -p ../warehouse-mobile/tsconfig.json && tsc -p ../attendance-mobile/tsconfig.json",
    "build:attendance": "tsc -p ../attendance-mobile/tsconfig.json && vite build --config vite.attendance.config.ts",
    "build": "tsc -b && vite build && tsc -p ../warehouse-mobile/tsconfig.json && vite build --config vite.mobile.config.ts && pnpm run build:attendance"
  },
  "dependencies": {
    "@metaforge/adapter-frappe": "workspace:*",
    "@metaforge/controls": "workspace:*",
    "@metaforge/core": "workspace:*",
    "@metaforge/shell": "workspace:*",
    "@metaforge/ui": "workspace:*",
    "@metaforge/views": "workspace:*",
    "jsqr": "1.4.0",
    "lucide-react": "^0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "5.6.3",
    "vite": "6.4.3"
  }
}
